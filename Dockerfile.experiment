FROM python:3.9-slim

# Установите необходимые зависимости
RUN pip install --upgrade pip && \
    pip install scikit-learn boto3 mlflow pandas numpy

# Копируйте скрипт для запуска эксперимента
COPY experiment.py /app/experiment.py
WORKDIR /app

# Укажите точку входа для запуска эксперимента
ENTRYPOINT ["python", "experiment.py"]